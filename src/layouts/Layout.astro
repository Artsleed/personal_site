---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Nathaniel Felsky-Deelstra</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="/" class="name">Nathaniel Felsky-Deelstra</a>
        <div class="links">
          <a href="/about">About</a>
          <a href="/now">Now</a>
          <a href="/blog">Blog</a>
          <a href="/projects">Projects</a>
          <a href="/resume">Resume</a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>
        <a href="mailto:nathanielfd5@gmail.com">Email</a>
        <a href="https://www.linkedin.com/in/nathaniel-felsky-deelstra/">LinkedIn</a>
        <a href="https://github.com/Artsleed">GitHub</a>
      </p>
    </footer>
  </body>
</html>

<style>
  *, *::before, *::after {
    box-sizing: border-box;
  }

  html, body {
    margin: 0;
    padding: 0;
    min-height: 100vh;
    font-family: system-ui, sans-serif;
  }

  body {
    display: flex;
    flex-direction: column;
  }

  header {
    padding: 1rem 2rem;
    border-bottom: 1px solid #e0e0e0;
  }

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 900px;
    margin: 0 auto;
  }

  nav .name {
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
    color: inherit;
  }

  nav .links {
    display: flex;
    gap: 1.5rem;
  }

  nav .links a {
    text-decoration: none;
    color: inherit;
    font-size: 0.95rem;
  }

  nav .links a:hover {
    text-decoration: underline;
  }

  main {
    flex: 1;
    max-width: 900px;
    width: 100%;
    margin: 0 auto;
    padding: 2rem;
  }

  footer {
    border-top: 1px solid #e0e0e0;
    padding: 1.5rem 2rem;
    text-align: center;
  }

  footer p {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin: 0;
  }

  footer a {
    text-decoration: none;
    color: inherit;
    font-size: 0.9rem;
  }

  footer a:hover {
    text-decoration: underline;
  }
</style>