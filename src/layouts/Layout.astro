---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Nathaniel Felsky-Deelstra</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="/" class="name">Nathaniel Felsky-Deelstra</a>
        <div class="links">
          <a href="/about">About</a>
          <a href="/now">Now</a>
          <a href="/blog">Blog</a>
          <a href="/projects">Projects</a>
          <a href="/resume">Resume</a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>
        <a href="mailto:nathanielfd5@gmail.com">Email</a>
        <a href="https://www.linkedin.com/in/nathaniel-felsky-deelstra/">LinkedIn</a>
        <a href="https://github.com/Artsleed">GitHub</a>
      </p>
    </footer>
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
  }

  header {
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-1) var(--space-3);
    max-width: var(--page-width);
    margin: 0 auto;
  }

  nav .name {
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
    color: var(--color-text);
  }

  nav .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
  }

  nav .links a {
    text-decoration: none;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  nav .links a:hover {
    color: var(--color-accent);
  }

  main {
    flex: 1;
    max-width: var(--page-width);
    width: 100%;
    margin: 0 auto;
    padding: var(--space-4);
  }

  footer {
    border-top: 1px solid var(--color-border);
    padding: var(--space-3) var(--space-4);
    text-align: center;
  }

  footer p {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
  }

  footer a {
    text-decoration: none;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  footer a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 480px) {
    header {
      padding: var(--space-2);
    }

    main {
      padding: var(--space-3);
    }
  }
</style>