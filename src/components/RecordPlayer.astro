---
// Interactive "now playing" widget styled as a record player - the vinyl
// spins and the tonearm drops onto it while a track is actively playing.
// Data is hydrated client-side in now.astro (see #record-* ids below).
---

<div class="record-player ticked">
  <span class="spec-label">Now Playing</span>
  <div class="turntable">
    <div class="tonearm" id="record-tonearm"></div>
    <div class="platter">
      <div class="record" id="record-disc">
        <img class="label" id="record-label" alt="" />
        <div class="spindle"></div>
      </div>
    </div>
  </div>
  <div class="track-info">
    <span class="status" id="record-status">Loading&hellip;</span>
    <a class="track-link" id="record-link" href="#" target="_blank" rel="noopener noreferrer">
      <span class="title" id="record-title"></span>
      <span class="artist" id="record-artist"></span>
    </a>
  </div>
</div>

<style>
  .record-player {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  .turntable {
    position: relative;
    width: 100%;
    max-width: 220px;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .platter {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-label) 8%, transparent);
    border: 1px solid var(--color-border-strong);
  }

  .record {
    position: absolute;
    inset: 6%;
    border-radius: 50%;
    background:
      repeating-radial-gradient(
        circle at center,
        rgba(0, 0, 0, 0.55) 0px,
        rgba(0, 0, 0, 0.55) 1px,
        transparent 2px,
        transparent 4px
      ),
      #100e0c;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 18px -6px rgba(0, 0, 0, 0.6);
  }

  .record.is-playing {
    animation: spin 2.8s linear infinite;
  }

  .label {
    width: 46%;
    height: 46%;
    border-radius: 50%;
    object-fit: cover;
    background: var(--color-bg);
  }

  .spindle {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-label);
  }

  .tonearm {
    position: absolute;
    top: -6%;
    right: -4%;
    width: 42%;
    height: 3px;
    background: var(--color-label);
    border-radius: 2px;
    transform-origin: 100% 0%;
    transform: rotate(-32deg);
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .tonearm::before {
    content: "";
    position: absolute;
    top: -4px;
    right: -4px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-label);
  }

  .tonearm.is-playing {
    transform: rotate(-4deg);
  }

  .track-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    text-align: center;
    min-width: 0;
    max-width: 100%;
  }

  .status {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-label);
  }

  .track-link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    max-width: 100%;
  }

  .title {
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--color-heading);
    font-size: 0.95rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 260px;
  }

  .artist {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 260px;
  }

  .track-link:hover .title {
    color: var(--color-accent);
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .record.is-playing {
      animation: none;
    }

    .tonearm {
      transition: none;
    }
  }
</style>
