---
interface Props {
  filename: string;
  class?: string;
}

const { filename, class: className } = Astro.props;
---

<div class:list={['terminal-window', className]}>
  <div class="titlebar">
    <span class="dots">
      <span class="dot dot-1"></span>
      <span class="dot dot-2"></span>
      <span class="dot dot-3"></span>
    </span>
    <span class="filename">{filename}</span>
  </div>
  <div class="body">
    <slot />
  </div>
</div>

<style>
  .terminal-window {
    background: var(--color-surface);
    border: 1px solid var(--color-chrome-border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .titlebar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.55rem var(--space-2);
    background: var(--color-chrome);
    border-bottom: 1px solid var(--color-chrome-border);
  }

  .dots {
    display: flex;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot-1 {
    background: var(--color-dot-1);
  }

  .dot-2 {
    background: var(--color-dot-2);
  }

  .dot-3 {
    background: var(--color-dot-3);
  }

  .filename {
    font-size: 0.8rem;
    color: var(--color-text-faint);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .body {
    padding: var(--space-3);
  }
</style>
