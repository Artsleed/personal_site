---
interface Props {
  filename: string;
  class?: string;
  [key: string]: unknown;
}

const { filename, class: className, ...rest } = Astro.props;
---

<div class:list={['terminal-window', className]} {...rest}>
  <div class="titlebar">
    <span class="filename">{filename}</span>
  </div>
  <div class="body">
    <slot />
  </div>
</div>

<style>
  .terminal-window {
    background: var(--color-surface);
    border: 1px solid var(--color-chrome-border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .titlebar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.55rem var(--space-2);
    background: var(--color-chrome);
    border-bottom: 1px solid var(--color-chrome-border);
  }

  .filename {
    font-size: 0.8rem;
    color: var(--color-text-faint);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .body {
    padding: var(--space-3);
  }
</style>
