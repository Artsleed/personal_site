---
// Interactive "recently watched" widget styled as an old TV - the screen
// shows one Letterboxd poster at a time, with channel-style prev/next
// controls to cycle through the rest. Data is hydrated client-side in
// now.astro (see #tv-* ids below).
---

<div class="tv-set ticked">
  <span class="spec-label">Recently Watched</span>
  <div class="tv">
    <div class="screen">
      <img class="poster" id="tv-poster" alt="" />
      <div class="scanlines"></div>
      <span class="channel" id="tv-channel">CH 01</span>
    </div>
    <div class="stand"><span></span><span></span></div>
  </div>
  <div class="tv-controls">
    <button type="button" class="tv-btn" id="tv-prev" aria-label="Previous film">&lsaquo;</button>
    <a class="film-title" id="tv-title" href="#" target="_blank" rel="noopener noreferrer">Loading&hellip;</a>
    <button type="button" class="tv-btn" id="tv-next" aria-label="Next film">&rsaquo;</button>
  </div>
</div>

<style>
  .tv-set {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  .tv {
    width: 100%;
    max-width: 240px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .screen {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    background: #0c0b0a;
    border: 10px solid color-mix(in srgb, var(--color-label) 14%, var(--color-bg));
    border-radius: 10px;
    overflow: hidden;
    box-shadow: inset 0 0 0 1px var(--color-border-strong);
  }

  .poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity var(--duration-fast) ease;
  }

  .poster.is-switching {
    opacity: 0;
  }

  .scanlines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.18) 0,
      rgba(0, 0, 0, 0.18) 1px,
      transparent 1px,
      transparent 3px
    );
  }

  .channel {
    position: absolute;
    top: 0.4rem;
    right: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    color: rgba(244, 242, 238, 0.7);
    text-shadow: 0 0 4px rgba(0, 0, 0, 0.8);
  }

  .stand {
    display: flex;
    gap: 0.6rem;
    margin-top: -2px;
  }

  .stand span {
    width: 10px;
    height: 14px;
    background: color-mix(in srgb, var(--color-label) 14%, var(--color-bg));
    border-radius: 0 0 3px 3px;
  }

  .tv-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    width: 100%;
    max-width: 260px;
  }

  .tv-btn {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border-strong);
    border-radius: 50%;
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    transition: color var(--duration-fast) ease, border-color var(--duration-fast) ease;
  }

  .tv-btn:hover,
  .tv-btn:focus-visible {
    color: var(--color-accent);
    border-color: var(--color-accent);
    outline: none;
  }

  .film-title {
    flex: 1;
    min-width: 0;
    text-align: center;
    text-decoration: none;
    font-size: 0.88rem;
    color: var(--color-heading);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color var(--duration-fast) ease;
  }

  .film-title:hover {
    color: var(--color-accent);
  }
</style>
