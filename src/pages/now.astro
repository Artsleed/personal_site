---
import Layout from '../layouts/Layout.astro';
import TerminalWindow from '../components/TerminalWindow.astro';

const title = 'Now';
---

<Layout title="Now">
  <div class="now">
    <p class="kicker">Today</p>
    <h1 class="page-title typewriter" style={`--steps: ${title.length}`}>{title}</h1>

    <div class="full-bleed now-window">
      <TerminalWindow filename="now.md" data-reveal>
        <section>
          <h2 class="section-heading">Now Playing</h2>
          <div id="now-playing" class="now-playing">
            <p class="loading">Loading...</p>
          </div>
        </section>

        <section>
          <h2 class="section-heading">What I'm Working On</h2>
          <ul>
            <li>finishing this website</li>
            <li>Another thing you're working on, is also trying to find a way to spend the summer</li>
          </ul>
        </section>

        <section>
          <h2 class="section-heading">Recently Watched</h2>
          <div id="letterboxd" class="films">
            <p class="loading">Loading...</p>
          </div>
        </section>
      </TerminalWindow>
    </div>
  </div>
</Layout>

<script>
  async function fetchNowPlaying() {
    const container = document.getElementById('now-playing');
    if (!container) return;

    try {
      const res = await fetch('/api/now-playing');
      const data = await res.json();

      if (!res.ok || data.error || !data.title) {
        container.innerHTML = '<p class="loading">Nothing played recently.</p>';
        return;
      }

      container.replaceChildren();

      const link = document.createElement('a');
      link.href = data.songUrl;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.className = 'track';

      if (data.albumArt) {
        const img = document.createElement('img');
        img.src = data.albumArt;
        img.alt = data.album ?? '';
        link.appendChild(img);
      }

      const info = document.createElement('div');
      info.className = 'info';

      const status = document.createElement('span');
      status.className = 'status';
      status.textContent = data.isPlaying ? '♪ Now Playing' : 'Last played';
      info.appendChild(status);

      const title = document.createElement('span');
      title.className = 'title';
      title.textContent = data.title;
      info.appendChild(title);

      const artist = document.createElement('span');
      artist.className = 'artist';
      artist.textContent = data.artist;
      info.appendChild(artist);

      link.appendChild(info);
      container.appendChild(link);
    } catch {
      container.innerHTML = '<p class="loading">Could not load Spotify status.</p>';
    }
  }

  async function fetchLetterboxd() {
    const container = document.getElementById('letterboxd');
    if (!container) return;

    try {
      const res = await fetch('https://api.rss2json.com/v1/api.json?rss_url=https://letterboxd.com/Artsleed/rss/');
      const data = await res.json();
      const films = data.items.slice(0, 5);

      container.innerHTML = films.map(film => {
        const title = film.title;
        const link = film.link;

        // Extract image from description HTML
        const parser = new DOMParser();
        const doc = parser.parseFromString(film.description, 'text/html');
        const img = doc.querySelector('img');
        const thumb = img ? img.src : null;

        return `
        <a href="${link}" target="_blank" class="film">
        ${thumb ? `<img src="${thumb}" alt="${title}" />` : ''}
        <span>${title}</span>
        </a>
        `;
      }).join('');
    } catch {
      container.innerHTML = '<p>Could not load films.</p>';
    }
  }

  let nowPlayingInterval;

  function init() {
    fetchNowPlaying();
    fetchLetterboxd();
    clearInterval(nowPlayingInterval);
    nowPlayingInterval = setInterval(fetchNowPlaying, 30000);
  }

  document.addEventListener('astro:page-load', init);
</script>

<style>
  .now {
    max-width: var(--page-width);
  }

  .page-title {
    margin-bottom: var(--space-4);
  }

  .now-window {
    padding: 0 var(--space-5);
  }

  @media (max-width: 480px) {
    .now-window {
      padding: 0 var(--space-3);
    }
  }

  section:not(:first-child) {
    margin-top: var(--space-4);
  }

  section:first-child .section-heading {
    margin-top: 0;
  }

  ul {
    line-height: 1.8;
    color: var(--color-text-muted);
  }

  ul li::marker {
    color: var(--color-accent);
  }

  .loading {
    color: var(--color-text-faint);
  }
</style>

<style is:global>
  /* These target elements injected client-side (innerHTML/createElement) for the
     now-playing and letterboxd widgets, which never receive Astro's scoped
     data-astro-cid attribute, so these rules must stay unscoped. */
  .now-playing .track {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    max-width: 400px;
  }

  .now-playing .track:hover {
    border-color: var(--color-accent);
  }

  .now-playing img {
    width: 56px;
    height: 56px;
    object-fit: cover;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .now-playing .info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .now-playing .status {
    font-size: 0.75rem;
    color: var(--color-accent);
    font-weight: 600;
  }

  .now-playing .title {
    font-size: 0.95rem;
    color: var(--color-text);
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .now-playing .artist {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .films {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: flex-start;
  }

  .film {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    width: 100px;
    text-align: center;
  }

  .film:hover {
    color: var(--color-accent);
  }

  .film img {
    width: 100px;
    height: 150px;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    transition: border-color 0.15s ease;
  }

  .film:hover img {
    border-color: var(--color-accent);
  }
</style>