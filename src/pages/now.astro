---
import Layout from '../layouts/Layout.astro';
import DeskScene from '../components/DeskScene.astro';

const title = 'Now';
const workingOn = ['Magic Mirror', 'School prep'];
---

<Layout title="Now">
  <div class="now">
    <p class="kicker">Today</p>
    <h1 class="page-title">{title}</h1>

    <div class="full-bleed scene-breakout">
      <DeskScene workingOn={workingOn} />
    </div>
  </div>
</Layout>

<style>
  .now {
    max-width: var(--page-width);
  }

  .scene-breakout {
    margin-top: var(--space-1);
  }
</style>
