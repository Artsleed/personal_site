---
import Layout from '../layouts/Layout.astro';
import TerminalWindow from '../components/TerminalWindow.astro';
---

<Layout title="Resume">
  <div class="resume" data-reveal>
    <p class="kicker">CV</p>
    <div class="header">
      <h1 class="page-title">Resume</h1>
      <a href="/Nathaniel_Felsky_Deelstra_resume.pdf" download class="btn-download">Download PDF</a>
    </div>
    <div class="viewer">
      <TerminalWindow filename="Nathaniel_Felsky_Deelstra_resume.pdf">
        <iframe
          class="resume-frame"
          src="/Nathaniel_Felsky_Deelstra_resume.pdf"
          width="100%"
          height="900px"
        />
      </TerminalWindow>
    </div>
  </div>
</Layout>

<style>
  .header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .page-title {
    margin: 0;
  }

  .btn-download {
    padding: 0.6rem 1.3rem;
    text-decoration: none;
    color: var(--color-accent-contrast);
    background: var(--color-accent);
    font-size: 0.9rem;
    font-weight: 600;
    border-radius: var(--radius);
    transition: opacity var(--duration-fast) ease, transform var(--duration-fast) ease;
  }

  .btn-download:hover {
    opacity: 0.88;
    transform: translateY(-2px);
  }

  .viewer {
    margin-top: var(--space-3);
  }

  .resume-frame {
    display: block;
    border: none;
  }
</style>