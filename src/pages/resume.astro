---
import Layout from '../layouts/Layout.astro';
import TerminalWindow from '../components/TerminalWindow.astro';

const title = 'Resume';
---

<Layout title="Resume">
  <div class="resume" data-reveal>
    <p class="kicker">CV</p>
    <h1 class="page-title typewriter" style={`--steps: ${title.length}`}>{title}</h1>
    <div class="viewer">
      <TerminalWindow filename="Nathaniel_Felsky_Deelstra_resume.pdf">
        <iframe
          class="resume-frame"
          src="/Nathaniel_Felsky_Deelstra_resume.pdf"
          width="100%"
          height="900px"
        />
      </TerminalWindow>
    </div>
  </div>
</Layout>

<style>
  :global(main:has(.resume)) {
    margin: 0 auto;
  }

  .resume {
    max-width: 900px;
    margin: 0 auto;
  }

  .viewer {
    margin-top: var(--space-3);
  }

  .resume-frame {
    display: block;
    border: none;
  }
</style>