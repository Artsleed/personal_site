---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Resume">
  <div class="resume">
    <p class="kicker">CV</p>
    <div class="header">
      <h1>Resume</h1>
      <a href="/Nathaniel_Felsky_Deelstra_resume.pdf" download class="btn-download">Download PDF</a>
    </div>
    <iframe
      src="/Nathaniel_Felsky_Deelstra_resume.pdf"
      width="100%"
      height="900px"
    />
  </div>
</Layout>

<style>
  .kicker {
    color: var(--color-accent);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 var(--space-1) 0;
  }

  .header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  h1 {
    font-size: 2rem;
    margin: 0;
  }

  .btn-download {
    padding: 0.6rem 1.3rem;
    text-decoration: none;
    color: var(--color-accent-contrast);
    background: var(--color-accent);
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: var(--radius);
    transition: opacity 0.15s ease;
  }

  .btn-download:hover {
    opacity: 0.88;
  }

  iframe {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
</style>