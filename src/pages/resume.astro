---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Resume">
  <div class="resume">
    <div class="header">
      <h1>Resume</h1>
      <a href="/Nathaniel_Felsky_Deelstra_resume.pdf" download>Download PDF</a>
    </div>
    <iframe
      src="/Nathaniel_Felsky_Deelstra_resume.pdf"
      width="100%"
      height="900px"
    />
  </div>
</Layout>

<style>
  .header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  h1 {
    font-size: 2rem;
    margin: 0;
  }

  a {
    padding: 0.5rem 1.2rem;
    border: 1px solid var(--color-text);
    text-decoration: none;
    color: var(--color-text);
    font-size: 0.95rem;
    border-radius: var(--radius);
  }

  a:hover {
    background: var(--color-text);
    color: var(--color-bg);
  }

  iframe {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
</style>