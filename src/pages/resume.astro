---
import Layout from '../layouts/Layout.astro';
import TerminalWindow from '../components/TerminalWindow.astro';

const title = 'Resume';
---

<Layout title="Resume">
  <div class="resume" data-reveal>
    <p class="kicker">CV</p>
    <h1 class="page-title typewriter" style={`--steps: ${title.length}`}>{title}</h1>
    <div class="full-bleed viewer-breakout">
      <div class="viewer">
        <TerminalWindow filename="Nathaniel_Felsky_Deelstra_resume.pdf">
          <iframe
            class="resume-frame"
            src="/Nathaniel_Felsky_Deelstra_resume.pdf"
            width="100%"
            height="900px"
          />
        </TerminalWindow>
      </div>
    </div>
  </div>
</Layout>

<style>
  .viewer-breakout {
    margin-top: var(--space-3);
  }

  .viewer {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  .resume-frame {
    display: block;
    border: none;
  }
</style>