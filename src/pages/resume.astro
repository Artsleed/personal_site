---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Resume">
  <div class="resume">
    <div class="header">
      <h1>Resume</h1>
      <a href="/Nathaniel_Felsky_Deelstra_resume.pdf" download>Download PDF</a>
    </div>
    <iframe
      src="/Nathaniel_Felsky_Deelstra_resume.pdf"
      width="100%"
      height="900px"
    />
  </div>
</Layout>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  h1 {
    font-size: 2rem;
    margin: 0;
  }

  a {
    padding: 0.5rem 1.2rem;
    border: 1px solid #000;
    text-decoration: none;
    color: #000;
    font-size: 0.95rem;
    border-radius: 4px;
  }

  a:hover {
    background: #000;
    color: #fff;
  }

  iframe {
    border: 1px solid #e0e0e0;
    border-radius: 4px;
  }
</style>