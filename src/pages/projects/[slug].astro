---
import Layout from '../../layouts/Layout.astro';
import TerminalWindow from '../../components/TerminalWindow.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout title={project.data.title}>
  <article class="project">
    <a href="/projects" class="back-link">&larr; Projects</a>
    <h1 class="typewriter" style={`--steps: ${project.data.title.length}`}>{project.data.title}</h1>
    <p class="description">{project.data.description}</p>
    <TerminalWindow filename={`${project.id}.md`} class="window" data-reveal>
      <div class="content">
        <Content />
      </div>
    </TerminalWindow>
  </article>
</Layout>

<style>
  .project {
    max-width: var(--content-width);
  }

  h1 {
    font-size: clamp(1.3rem, 5.5vw, 2rem);
    margin-bottom: var(--space-1);
  }

  .description {
    color: var(--color-text-faint);
    margin-bottom: var(--space-3);
  }

  .content {
    line-height: 1.8;
    color: var(--color-text);
  }
</style>
