---
import Layout from '../../layouts/Layout.astro';
import SpecHeader from '../../components/SpecHeader.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout title={project.data.title}>
  <article class="project">
    <a href="/projects" class="back-link">&larr; Projects</a>
    <h1 class="aside-trigger">
      {project.data.title}
      {project.data.aside && <span class="aside title-aside">{project.data.aside}</span>}
    </h1>
    <p class="description">{project.data.description}</p>

    <div class="full-bleed spec-breakout">
      <SpecHeader
        stack={project.data.stack}
        status={project.data.status}
        role={project.data.role}
        started={project.data.started}
      />
    </div>

    {project.data.processNote && (
      <div class="full-bleed note-breakout">
        <div class="process-note">
          <span class="spec-label">Process note</span>
          <p>{project.data.processNote}</p>
        </div>
      </div>
    )}

    <div class="full-bleed content-breakout">
      <div class="content" data-reveal>
        <Content />
      </div>
    </div>
  </article>
</Layout>

<style>
  .project {
    max-width: var(--content-width);
  }

  h1 {
    font-size: clamp(1.6rem, 5vw, 2.4rem);
    margin: 0 0 var(--space-1) 0;
  }

  .title-aside {
    display: block;
    font-size: 1.1rem;
    margin-top: 0.2rem;
  }

  .description {
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .spec-breakout,
  .note-breakout,
  .content-breakout {
    padding: 0 var(--space-5);
  }

  .note-breakout {
    margin-top: var(--space-3);
  }

  .content-breakout {
    margin-top: var(--space-4);
  }

  @media (max-width: 480px) {
    .spec-breakout,
    .note-breakout,
    .content-breakout {
      padding: 0 var(--space-3);
    }
  }

  .process-note {
    border-left: 2px solid var(--color-accent);
    padding: 0.25rem var(--space-3);
    background: color-mix(in srgb, var(--color-accent) 5%, transparent);
  }

  .process-note p {
    margin: 0.35rem 0 0 0;
    color: var(--color-text-muted);
  }

  .content {
    line-height: 1.8;
    color: var(--color-body);
  }
</style>
