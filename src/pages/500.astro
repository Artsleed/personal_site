---
// Astro renders this for unhandled errors on server-rendered routes (the
// /api/now-playing endpoint, or any future SSR page). It receives the
// thrown error as a prop, but we deliberately don't render error.message
// or a stack trace to the client - that's an internal detail, not
// something to disclose in a production response.
export const prerender = false;

import Layout from '../layouts/Layout.astro';
---

<Layout title="Server Error">
  <div class="error-page">
    <p class="kicker">Error</p>
    <h1 class="aside-trigger">
      500
      <span class="aside">(definitely not you, this one's mine.)</span>
    </h1>
    <p class="dek">Something broke on the server. Try refreshing in a sec, or head back home.</p>
    <div class="cta-row">
      <a href="/" class="btn primary">Back home</a>
      <a href="mailto:nathanielfd5@gmail.com" class="btn">Let me know</a>
    </div>
  </div>
</Layout>

<style>
  .error-page {
    max-width: 560px;
    padding-top: var(--space-4);
  }

  h1 {
    font-size: clamp(3.5rem, 12vw, 6rem);
    line-height: 1;
    margin: 0 0 var(--space-3) 0;
  }

  .dek {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-4) 0;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .btn {
    display: inline-block;
    padding: 0.65rem 1.4rem;
    border-radius: var(--radius);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    background: transparent;
    color: var(--color-heading);
    border: 1px solid var(--color-border-strong);
    transition: border-color var(--duration-fast) ease, color var(--duration-fast) ease, transform var(--duration-fast) ease;
  }

  .btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    transform: translateY(-2px);
  }

  .btn.primary {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    border-color: var(--color-accent);
  }

  .btn.primary:hover {
    color: var(--color-accent-contrast);
    opacity: 0.9;
  }
</style>
