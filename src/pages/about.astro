---
import Layout from '../layouts/Layout.astro';
import TerminalWindow from '../components/TerminalWindow.astro';

const title = 'About';

const sections = [
  {
    heading: 'Background',
    body: "Hello! My name is Nathaniel, and I'm a Computer Engineering student at Queen's University. I'm originally from Brantford, Ontario where my love of videogames and technology led me to explore the interactions between hardware and software. Being able to take any problem, break it down and then solve it is one of my favorite feelings in the world.",
  },
  {
    heading: 'Engineering',
    body: "I'm most passionate about projects that solve real issues and every now and then I like to throw in a random project just for fun. Im most interested in ML, CV, Quantum compute, and embedded systems.",
  },
  {
    heading: 'Outside Engineering',
    body: 'Outside of Engineering I love riding my bike, rock climbing, watching movies, reading, playing videogames, and hanging out with my cats.',
  },
];

const interests = [
  { id: 'climbing', label: 'Climbing', fact: "Currently aiming to get V7 before the end of the year." },
  { id: 'biking', label: 'Biking', fact: "I love riding around on trails to find interesting spots." },
  { id: 'gaming', label: 'Gaming', fact: "Currently way into Apex with some occasional Brawl." },
  { id: 'movies', label: 'Movies', fact: "I really like chilling with a movie when I get some downtime, check the Now page for my latest watches." },
  { id: 'reading', label: 'Reading', fact: "Mostly sci-fi and fantasy with some books about science and improvement." },
  { id: 'cats', label: 'Cats', fact: "I have two black cats named Coal, and Remi who are very fuzzy." },
];
---

<Layout title="About">
  <div class="about">
    <p class="kicker">Who I Am</p>
    <h1 class="page-title typewriter" style={`--steps: ${title.length}`}>{title}</h1>

    <div class="content-row">
      <TerminalWindow filename="about.md" class="bio" data-reveal>
        {sections.map((section) => (
          <section>
            <h2 class="section-heading">{section.heading}</h2>
            <p>{section.body}</p>
          </section>
        ))}
      </TerminalWindow>

      <TerminalWindow filename="portrait.jpg" class="portrait" data-reveal style="transition-delay: 0.1s">
        <div class="portrait-placeholder">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="12" cy="8" r="4" />
            <path d="M4 20c0-4 3.5-7 8-7s8 3 8 7" />
          </svg>
          <span>// awaiting photo</span>
        </div>
      </TerminalWindow>
    </div>

    <div class="interest-row" data-reveal style="transition-delay: 0.2s">
      <div class="interest-item">
        <button type="button" class="interest-icon" aria-label={interests[0].label}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M3 20l6-11 4 6 2-3 6 8H3z" />
          </svg>
          <span>{interests[0].label}</span>
        </button>
        <div class="interest-tooltip" role="tooltip">{interests[0].fact}</div>
      </div>

      <div class="interest-item">
        <button type="button" class="interest-icon" aria-label={interests[1].label}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <circle cx="6" cy="17" r="3.5" />
            <circle cx="18" cy="17" r="3.5" />
            <path d="M6 17l4-8h4l4 8M10 9h4M13 5h3l2 4" />
          </svg>
          <span>{interests[1].label}</span>
        </button>
        <div class="interest-tooltip" role="tooltip">{interests[1].fact}</div>
      </div>

      <div class="interest-item">
        <button type="button" class="interest-icon" aria-label={interests[2].label}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <rect x="3" y="8" width="18" height="9" rx="4" />
            <path d="M8 12h-2m1-1v2M15 12h.01M18 10h.01" />
          </svg>
          <span>{interests[2].label}</span>
        </button>
        <div class="interest-tooltip" role="tooltip">{interests[2].fact}</div>
      </div>

      <div class="interest-item">
        <button type="button" class="interest-icon" aria-label={interests[3].label}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <rect x="3" y="7" width="18" height="13" rx="1.5" />
            <path d="M3 11h18M6 7l2-4h3l-2 4M13 7l2-4h3l-2 4" />
          </svg>
          <span>{interests[3].label}</span>
        </button>
        <div class="interest-tooltip" role="tooltip">{interests[3].fact}</div>
      </div>

      <div class="interest-item">
        <button type="button" class="interest-icon" aria-label={interests[4].label}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M4 19.5A2.5 2.5 0 016.5 17H20V3H6.5A2.5 2.5 0 004 5.5v14z" />
            <path d="M4 19.5A2.5 2.5 0 006.5 22H20" />
          </svg>
          <span>{interests[4].label}</span>
        </button>
        <div class="interest-tooltip" role="tooltip">{interests[4].fact}</div>
      </div>

      <div class="interest-item">
        <button type="button" class="interest-icon" aria-label={interests[5].label}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <circle cx="7" cy="9" r="1.7" />
            <circle cx="12" cy="6.5" r="1.7" />
            <circle cx="17" cy="9" r="1.7" />
            <path d="M8 14c0-2.5 2-4 4-4s4 1.5 4 4-2 4-4 4-4-1.5-4-4z" />
          </svg>
          <span>{interests[5].label}</span>
        </button>
        <div class="interest-tooltip" role="tooltip">{interests[5].fact}</div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .about {
    max-width: var(--page-width);
  }

  .content-row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .portrait {
    flex-shrink: 0;
    width: 140px;
  }

  .portrait-placeholder {
    aspect-ratio: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    color: var(--color-text-faint);
    background: color-mix(in srgb, var(--color-text-faint) 6%, transparent);
    border: 1px dashed var(--color-chrome-border);
    border-radius: var(--radius);
  }

  .portrait-placeholder svg {
    width: 32%;
    height: 32%;
  }

  .portrait-placeholder span {
    font-size: 0.65rem;
    text-align: center;
  }

  .bio {
    flex: 1 1 400px;
    max-width: 760px;
  }

  section:not(:first-child) {
    margin-top: var(--space-3);
  }

  section:first-child .section-heading {
    margin-top: 0;
  }

  p {
    color: var(--color-text-muted);
  }

  .interest-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .interest-item {
    position: relative;
  }

  .interest-icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    width: 84px;
    padding: 0.75rem 0.5rem;
    background: transparent;
    color: var(--color-text-muted);
    border: none;
    border-radius: var(--radius);
    font-family: inherit;
    font-size: 0.75rem;
    cursor: pointer;
    transition: color var(--duration-fast) ease;
  }

  .interest-icon svg {
    width: 22px;
    height: 22px;
  }

  .interest-icon:hover,
  .interest-icon:focus-visible {
    color: var(--color-accent);
    outline: none;
  }

  .interest-tooltip {
    position: absolute;
    top: calc(100% + 0.4rem);
    left: 50%;
    transform: translateX(-50%);
    width: max-content;
    max-width: 200px;
    padding: 0.55rem 0.75rem;
    background: var(--color-surface);
    border: 1px solid var(--color-chrome-border);
    border-radius: var(--radius);
    color: var(--color-text-muted);
    font-size: 0.8rem;
    line-height: 1.5;
    text-align: center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--duration-fast) ease;
    z-index: 5;
  }

  .interest-icon:hover + .interest-tooltip,
  .interest-icon:focus-visible + .interest-tooltip {
    opacity: 1;
    visibility: visible;
  }

  @media (prefers-reduced-motion: reduce) {
    .interest-tooltip {
      transition: none;
    }
  }
</style>