---
import Layout from '../layouts/Layout.astro';
import Panel from '../components/Panel.astro';
import { getCollection } from 'astro:content';

const name = 'Nathaniel Felsky-Deelstra';

const latestProject = (await getCollection('projects')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
)[0];

const latestPost = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
)[0];
---

<Layout title="Home">
  <div class="hero">
    <p class="tag" data-reveal>// computer engineering @ queen's university</p>
    <h1 data-reveal style="transition-delay: 0.06s">{name}</h1>
    <p class="dek" data-reveal style="transition-delay: 0.14s">
      Building projects that fuse <span class="highlight">software</span> and <span class="highlight">hardware</span> to solve real problems. When I'm not working on a project I'm usually on a climbing wall, on a bike, or playing with my cats.
    </p>

    <div class="cta-row" data-reveal style="transition-delay: 0.22s">
      <a href="/projects" class="btn primary">View projects</a>
      <a href="/about" class="btn">About me</a>
    </div>

    <div class="card-row" data-reveal style="transition-delay: 0.3s">
      {latestProject && (
        <a href={`/projects/${latestProject.id}`} class="card tilt ticked">
          <span class="spec-label">Latest project</span>
          <h2>{latestProject.data.title}</h2>
          <p>{latestProject.data.description}</p>
        </a>
      )}
      {latestPost && (
        <a href={`/blog/${latestPost.id}`} class="card tilt ticked">
          <span class="spec-label">Latest writing</span>
          <h2>{latestPost.data.title}</h2>
          <p>{latestPost.data.description}</p>
        </a>
      )}
    </div>
  </div>
</Layout>

<style>
  .hero {
    max-width: 780px;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-accent);
    margin: 0 0 var(--space-2) 0;
  }

  h1 {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    line-height: 1.06;
    margin: 0 0 var(--space-3) 0;
  }

  .dek {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-text-muted);
    max-width: 60ch;
    margin: 0 0 var(--space-4) 0;
  }

  .highlight {
    color: var(--color-heading);
    font-weight: 600;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .btn {
    display: inline-block;
    padding: 0.65rem 1.4rem;
    border-radius: var(--radius);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    background: transparent;
    color: var(--color-heading);
    border: 1px solid var(--color-border-strong);
    transition: border-color var(--duration-fast) ease, color var(--duration-fast) ease, transform var(--duration-fast) ease;
  }

  .btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    transform: translateY(-2px);
  }

  .btn.primary {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    border-color: var(--color-accent);
  }

  .btn.primary:hover {
    color: var(--color-accent-contrast);
    opacity: 0.9;
  }

  .card-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }

  @media (max-width: 560px) {
    .card-row {
      grid-template-columns: 1fr;
    }
  }

  .card {
    display: block;
    text-decoration: none;
    color: var(--color-heading);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-3);
  }

  .card h2 {
    font-size: 1.1rem;
    margin: 0.2rem 0 0.5rem 0;
    transition: color var(--duration-fast) ease;
  }

  .card:hover h2 {
    color: var(--color-accent);
  }

  .card p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--color-text-muted);
  }
</style>
