---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
  <div class="hero">
    <h1>Nathaniel Felsky-Deelstra</h1>
    <p class="tagline">Computer Engineering student at Queen's University, building projects that fuse software and hardware to solve real problems. When I'm not working on a project I'm usually on a climbing wall, on a bike, or playing with my cats.</p>
    
  </div>
</Layout>

<style>
  .hero {
    padding: var(--space-5) 0;
  }

  h1 {
    font-size: 2.5rem;
    margin: 0 0 var(--space-2) 0;
  }

  .tagline {
    font-size: 1.1rem;
    line-height: 1.6;
    max-width: var(--content-width);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-4) 0;
  }
</style>