---
import Layout from '../layouts/Layout.astro';
import TerminalWindow from '../components/TerminalWindow.astro';

const name = 'Nathaniel Felsky-Deelstra';
const skills = ['ML', 'Computer Vision', 'Quantum Computing', 'Embedded Systems'];
---

<Layout title="Home">
  <div class="hero">
    <TerminalWindow filename="whoami.sh">
      <p class="comment"># Computer Engineering @ Queen's University</p>
      <h1 class="typewriter" style={`--steps: ${name.length}`}>{name}</h1>
      <p class="tagline" data-reveal style="transition-delay: 0.5s">
        Building projects that fuse <span class="highlight">software</span> and <span class="highlight">hardware</span> to solve real problems. When I'm not working on a project I'm usually on a climbing wall, on a bike, or playing with my cats.
      </p>

      <div class="cta-row" data-reveal style="transition-delay: 0.65s">
        <a href="/projects" class="btn btn-primary">View Projects</a>
        <a href="/about" class="btn btn-outline">About Me</a>
      </div>

      <div class="skills-output" data-reveal style="transition-delay: 0.8s">
        <span class="prompt-line">$ echo $SKILLS</span>
        <div class="tag-row">
          {skills.map((skill) => (
            <span class="tag">{skill}</span>
          ))}
        </div>
      </div>
    </TerminalWindow>
  </div>
</Layout>

<style>
  .hero {
    padding: var(--space-5) 0;
  }

  .comment {
    color: var(--color-text-faint);
    font-size: 0.85rem;
    margin: 0 0 var(--space-2) 0;
  }

  h1.typewriter {
    font-size: clamp(0.8rem, 4.3vw, 2.5rem);
    margin: 0 0 var(--space-2) 0;
  }

  .tagline {
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: var(--content-width);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-4) 0;
  }

  .highlight {
    color: var(--color-text);
    font-weight: 600;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .btn {
    display: inline-block;
    padding: 0.65rem 1.4rem;
    border-radius: var(--radius);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid transparent;
    transition: opacity var(--duration-fast) ease, border-color var(--duration-fast) ease, transform var(--duration-fast) ease;
  }

  .btn-primary {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }

  .btn-primary:hover {
    opacity: 0.88;
    transform: translateY(-2px);
  }

  .btn-outline {
    color: var(--color-text);
    border-color: var(--color-border);
  }

  .btn-outline:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    transform: translateY(-2px);
  }

  .skills-output {
    border-top: 1px dashed var(--color-border);
    padding-top: var(--space-3);
  }

  .prompt-line {
    display: block;
    color: var(--color-text-faint);
    font-size: 0.85rem;
    margin-bottom: 0.6rem;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    font-size: 0.8rem;
    color: var(--color-secondary);
    background: color-mix(in srgb, var(--color-secondary) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-secondary) 35%, transparent);
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius);
  }

</style>
