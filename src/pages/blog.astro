---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const title = 'Blog';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Blog">
  <div class="blog">
    <p class="kicker">Writing</p>
    <h1 class="page-title">{title}</h1>
    <div class="full-bleed list-breakout">
      <div class="post-list">
        {posts.map((post, i) => (
          <a href={`/blog/${post.id}`} class="post" data-reveal style={`transition-delay: ${i * 0.06}s`}>
            <span class="date-badge">{post.data.date.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>

<style>
  .blog {
    max-width: var(--page-width);
  }

  .list-breakout {
    margin-top: var(--space-4);
  }

  .post-list {
    display: flex;
    flex-direction: column;
    padding: 0 var(--space-5);
    max-width: var(--content-width);
  }

  @media (max-width: 480px) {
    .post-list {
      padding: 0 var(--space-3);
    }
  }

  .post {
    display: block;
    text-decoration: none;
    color: var(--color-heading);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
    transition: padding-left var(--duration-fast) ease;
  }

  .post:first-child {
    padding-top: 0;
  }

  .post:hover {
    padding-left: 0.4rem;
  }

  .post:hover h2 {
    color: var(--color-accent);
  }

  .post h2 {
    font-size: 1.35rem;
    /* Instrument Serif only ships weight 400 - see global.css's h1/h2/h3
       comment. This page's own scoped h2 rule was overriding that back to
       500 (invalid weight, triggers synthetic-bold) purely by being a
       same-specificity-but-later-in-source-order local rule. */
    font-weight: 400;
    margin: 0.4rem 0 0.4rem 0;
    transition: color var(--duration-fast) ease;
  }

  /* Scoped to `.post p`, not a bare `p` - see the matching note in
     projects.astro. A bare element selector here was overriding the
     global `.kicker` rule's accent color with this muted body color. */
  .post p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.92rem;
    max-width: 68ch;
  }

  @media (prefers-reduced-motion: reduce) {
    .post:hover {
      padding-left: 0;
    }
  }
</style>
