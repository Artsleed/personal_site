---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title}>
  <article class="post">
    <a href="/blog" class="back">&larr; Blog</a>
    <span class="date">{post.data.date.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
    <h1>{post.data.title}</h1>
    <div class="content">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .post {
    max-width: var(--content-width);
  }

  .back {
    display: inline-block;
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    margin-bottom: var(--space-3);
  }

  .back:hover {
    color: var(--color-accent);
  }

  .date {
    display: inline-block;
    font-size: 0.75rem;
    color: var(--color-secondary);
    background: color-mix(in srgb, var(--color-secondary) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-secondary) 35%, transparent);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }

  h1 {
    font-size: 2rem;
    margin: 0.75rem 0 var(--space-4) 0;
  }

  .content {
    line-height: 1.8;
    color: var(--color-text);
  }
</style>
