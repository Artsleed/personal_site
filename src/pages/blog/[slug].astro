---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title}>
  <article class="post">
    <a href="/blog" class="back-link">&larr; Blog</a>
    <span class="date-badge">{post.data.date.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
    <h1>{post.data.title}</h1>
    <div class="full-bleed content-breakout">
      <div class="content" data-reveal>
        <Content />
      </div>
    </div>
  </article>
</Layout>

<style>
  .post {
    max-width: var(--content-width);
  }

  h1 {
    font-size: clamp(1.6rem, 5vw, 2.4rem);
    margin: 0.6rem 0 var(--space-3) 0;
  }

  .content-breakout {
    padding: 0 var(--space-5);
  }

  @media (max-width: 480px) {
    .content-breakout {
      padding: 0 var(--space-3);
    }
  }

  .content {
    line-height: 1.85;
    color: var(--color-body);
  }
</style>
