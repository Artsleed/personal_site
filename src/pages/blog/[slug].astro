---
import Layout from '../../layouts/Layout.astro';
import TerminalWindow from '../../components/TerminalWindow.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title}>
  <article class="post">
    <a href="/blog" class="back-link">&larr; Blog</a>
    <span class="date-badge">{post.data.date.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
    <h1 class="typewriter" style={`--steps: ${post.data.title.length}`}>{post.data.title}</h1>
    <div class="full-bleed window-breakout">
      <TerminalWindow filename={`${post.id}.md`} class="window" data-reveal>
        <div class="content">
          <Content />
        </div>
      </TerminalWindow>
    </div>
  </article>
</Layout>

<style>
  .post {
    max-width: var(--content-width);
  }

  h1 {
    font-size: clamp(1.3rem, 5.5vw, 2rem);
    margin: 0.75rem 0 var(--space-3) 0;
  }

  .window-breakout {
    padding: 0 var(--space-5);
    margin-top: var(--space-1);
  }

  @media (max-width: 480px) {
    .window-breakout {
      padding: 0 var(--space-3);
    }
  }

  .content {
    line-height: 1.8;
    color: var(--color-text);
  }
</style>
