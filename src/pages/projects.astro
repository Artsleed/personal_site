---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const title = 'Projects';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Projects">
  <div class="projects">
    <p class="kicker">Work</p>
    <h1 class="page-title">{title}</h1>
    <div class="full-bleed list-breakout">
      <div class="project-list">
        {projects.map((project, i) => (
          <a href={`/projects/${project.id}`} class="project ticked tilt" data-reveal style={`transition-delay: ${i * 0.06}s`}>
            <div class="meta">
              <span class="spec-label">{project.data.status}</span>
              <span class="year">{project.data.date.getFullYear()}</span>
            </div>
            <h2>{project.data.title}</h2>
            <p>{project.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>

<style>
  .projects {
    max-width: var(--page-width);
  }

  .list-breakout {
    margin-top: var(--space-4);
  }

  .project-list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
    align-items: stretch;
    padding: 0 var(--space-5);
  }

  @media (max-width: 960px) {
    .project-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .project-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .project-list {
      padding: 0 var(--space-3);
    }
  }

  .project {
    display: block;
    text-decoration: none;
    color: var(--color-heading);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-3);
  }

  .project:hover h2 {
    color: var(--color-accent);
  }

  .meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }

  .meta .spec-label {
    margin-bottom: 0;
  }

  .year {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-label);
  }

  h2 {
    font-size: 1.15rem;
    margin: 0 0 0.5rem 0;
    transition: color var(--duration-fast) ease;
  }

  p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
</style>
