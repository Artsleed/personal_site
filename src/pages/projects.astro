---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const title = 'Projects';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Projects">
  <div class="projects">
    <p class="kicker">Work</p>
    <h1 class="page-title typewriter" style={`--steps: ${title.length}`}>{title}</h1>
    <div class="list-breakout">
      <div class="project-list">
        {projects.map((project, i) => (
          <a href={`/projects/${project.id}`} class="project" data-reveal style={`transition-delay: ${i * 0.08}s`}>
            <div class="titlebar">
              <span class="filename">{project.id}.md</span>
              <span class="hud-date">{project.data.date.getFullYear()}</span>
            </div>
            <div class="body">
              <h2>{project.data.title}</h2>
              <p>{project.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>

<style>
  .projects {
    max-width: var(--page-width);
  }

  /* main is left-justified and capped at --page-width, so this breaks
     out to the true viewport width (same technique as the resume PDF
     viewer) instead of leaving the grid capped and letting blank space
     sit unused on wide screens. */
  .list-breakout {
    width: 100vw;
    margin-left: calc(-1 * var(--space-5));
    margin-top: var(--space-4);
  }

  @media (max-width: 480px) {
    .list-breakout {
      margin-left: calc(-1 * var(--space-3));
    }
  }

  .project-list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
    align-items: stretch;
    padding: 0 var(--space-5);
  }

  @media (max-width: 960px) {
    .project-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .project-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .project-list {
      padding: 0 var(--space-3);
    }
  }

  .project {
    display: block;
    text-decoration: none;
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-chrome-border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color var(--duration-fast) ease, transform var(--duration-fast) ease, box-shadow var(--duration-fast) ease;
  }

  .project:hover {
    border-color: var(--color-accent);
    transform: translateY(-3px);
    box-shadow: 0 8px 24px -12px color-mix(in srgb, var(--color-accent) 40%, transparent);
  }

  .project:hover h2 {
    color: var(--color-accent);
  }

  .titlebar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.55rem var(--space-2);
    background: var(--color-chrome);
    border-bottom: 1px solid var(--color-chrome-border);
  }

  .filename {
    font-size: 0.78rem;
    color: var(--color-text-faint);
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hud-date {
    font-size: 0.72rem;
    color: var(--color-secondary);
    opacity: 0;
    transform: translateX(6px);
    transition: opacity var(--duration-base) ease, transform var(--duration-base) ease;
  }

  .project:hover .hud-date {
    opacity: 1;
    transform: translateX(0);
  }

  .body {
    padding: var(--space-3);
  }

  h2 {
    font-size: 1.15rem;
    margin: 0 0 0.5rem 0;
    transition: color var(--duration-fast) ease;
  }

  p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .project:hover {
      transform: none;
    }
  }
</style>
