---
// SSR (not the site's default static/prerendered) since "now playing" is
// only meaningful fetched fresh on each visit, not baked in at build time.
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Panel from '../components/Panel.astro';
import { fetchNowPlaying } from '../lib/spotify';

const title = 'On rotation';

let track: Awaited<ReturnType<typeof fetchNowPlaying>> = null;
let loadError = false;
try {
  track = await fetchNowPlaying();
} catch {
  loadError = true;
}
---

<Layout title="On rotation">
  <div class="music">
    <p class="kicker">Listening</p>
    <h1 class="page-title">{title}</h1>
    <p class="dek">What's on the turntable right now, live from Spotify.</p>

    {loadError && (
      <p class="error">Couldn't reach Spotify just now - try refreshing in a bit.</p>
    )}

    {!loadError && !track && (
      <Panel class="placeholder" data-reveal>
        <span class="spec-label">Quiet right now</span>
        <p>Nothing currently playing or recently played.</p>
      </Panel>
    )}

    {track && (
      <a class="track-panel" href={track.songUrl} target="_blank" rel="noopener" data-reveal>
        <Panel class="track-inner" tilt>
          <div class="art-wrap">
            {track.albumArt && <img src={track.albumArt} alt={`${track.title} — ${track.album}`} />}
          </div>
          <div class="track-meta">
            <span class="status">{track.isPlaying ? 'Now playing' : 'Last played'}</span>
            <span class="track-title">{track.title}</span>
            <span class="track-artist">{track.artist}</span>
            <span class="track-album">{track.album}</span>
          </div>
        </Panel>
      </a>
    )}
  </div>
</Layout>

<style>
  .music {
    max-width: var(--content-width);
  }

  .dek {
    color: var(--color-text-muted);
    margin: 0 0 var(--space-4) 0;
  }

  .error {
    color: var(--color-text-muted);
  }

  .placeholder p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .track-panel {
    display: block;
    text-decoration: none;
    color: inherit;
    max-width: 420px;
  }

  .track-inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .art-wrap {
    flex: none;
    width: 96px;
    height: 96px;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-surface-hover);
  }

  .art-wrap img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .track-meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .status {
    font-size: 0.75rem;
    color: var(--color-accent);
    margin-bottom: 0.2rem;
  }

  .track-title {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    color: var(--color-heading);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .track-artist {
    font-size: 0.88rem;
    color: var(--color-body);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .track-album {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
